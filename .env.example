# Copy to .env and fill in. .env is gitignored.
#
# The only required value. Used by the planner and by the two bounded model
# steps inside the po_reroute workflow.
ANTHROPIC_API_KEY=sk-ant-...

# auto    replay a recorded call when one exists, otherwise call the API and
#         record it. The default.
# replay  never call the API. A missing cassette is an error. What CI uses.
# record  always call the API and overwrite the cassette.
# live    always call the API, never read the cassette.
SILO_LLM_MODE=auto
